#!/bin/sh
# Stamped by dev-harness. The [message] tasks of harness.toml on the proposed
# commit message, whose file git passes as $1 (githooks: commit-msg); a task
# that fails refuses the commit. A rule about the message (an issue named, a
# reason given) has no other place: the pre-commit gate sees only the files.
ROOT="$(git rev-parse --show-toplevel)" || exit 1
L="$ROOT/dev-tools/harness.py"
[ -f "$L" ] || exit 0
exec python "$L" gate message "$1"
